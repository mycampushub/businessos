// OrgOS — Enterprise SaaS schema
// D1-compatible: string IDs (cuid), no list fields, JSON payloads stored as String.
// Deploying to Cloudflare D1: generate SQL via
//   bunx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script
// (see cloudflare/migrations in this repo)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ IDENTITY ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  headline      String?
  bio           String?
  location      String?
  phone         String?
  skills        String? // CSV
  emailVerified DateTime?
  platformAdmin Boolean   @default(false) // SaaS platform administrator (org-less console)
  status        String    @default("ACTIVE") // ACTIVE | SUSPENDED (platform moderation)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  memberships   Membership[]
  notifications Notification[]
  applications  Application[]
}

model Session {
  id             String   @id // uuid token
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  impersonatedBy String? // platform admin userId when this is a support (impersonation) session
  createdAt      DateTime @default(now())
}

// ============ ORGANIZATION (tenant) ============

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  industry    String?
  orgType     String? // Company | Startup | Agency | Team | Consultancy | Nonprofit | Community | Other
  website     String?
  country     String?
  timezone    String   @default("Asia/Dhaka")
  currency    String   @default("BDT")
  plan        String   @default("Growth") // Free | Starter | Growth | Business | Enterprise
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED (platform moderation)
  foundedYear Int?
  ownerId     String
  createdAt   DateTime @default(now())

  memberships    Membership[]
  departments    Department[]
  teams          Team[]
  projects       Project[]
  clients        Client[]
  companies      Company[]
  contacts       Contact[]
  leads          Lead[]
  deals          Deal[]
  pipelineStages PipelineStage[]
  jobs           Job[]
  invoices       Invoice[]
  expenses       Expense[]
  leaveTypes     LeaveType[]
  announcements  Announcement[]
  documents      Document[]
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  notifications  Notification[]
  activities     ActivityLog[]
  auditLogs      AuditLog[]
  crmActivities  CrmActivity[]
  comments       Comment[]
  meetings       Meeting[]
  tasks          Task[]
  holidays       Holiday[]

  // T3 additions
  moduleAccesses     ModuleAccess[]
  orgPolicy          OrgPolicy?
  attendanceSessions AttendanceSession[]
  boardColumns       BoardColumn[]
  payrollRuns        PayrollRun[]
  salaryComponents   SalaryComponent[]
}

model Membership {
  id               String       @id @default(cuid())
  userId           String
  orgId            String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role             String       @default("EMPLOYEE") // OWNER | ADMIN | MANAGER | HR | FINANCE | EMPLOYEE | CONTRACTOR | INTERN
  title            String? // position, e.g. "Senior Frontend Developer"
  departmentId     String?
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId        String? // manager Membership id
  employmentType   String       @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | FREELANCE | INTERN | TEMPORARY | VOLUNTEER
  status           String       @default("ACTIVE") // ACTIVE | ON_LEAVE | PROBATION | RESIGNED | TERMINATED | ALUMNI
  employeeCode     String?
  joinedAt         DateTime     @default(now())
  phone            String?
  emergencyContact String? // JSON {name, relation, phone}
  workSchedule     String? // JSON {days:[1..5], start:"09:30", end:"18:30"}
  baseSalary       Float? // monthly gross, org currency (T3)

  teamMembers    TeamMember[]
  projectMembers ProjectMember[]
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  activities     ActivityLog[]
  auditLogs      AuditLog[]
  crmActivities  CrmActivity[]
  comments       Comment[]
  documents      Document[]
  announcements  Announcement[]
  meetings       Meeting[]
  applications   Application[]   @relation("ApplicationProcessor")
  expenses       Expense[]

  // T3 additions
  attendanceSessions  AttendanceSession[]
  salaryComponents    SalaryComponent[]
  payslips            Payslip[]
  payrollRunsCreated  PayrollRun[]    @relation("PayrollRunCreatedBy")
  payrollRunsApproved PayrollRun[]    @relation("PayrollRunApprovedBy")

  @@unique([userId, orgId])
}

model Department {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String? // hex accent for UI
  parentId    String? // self hierarchy
  createdAt   DateTime     @default(now())

  memberships Membership[]
  teams       Team[]
  jobs        Job[]
}

model Team {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String
  description  String?
  createdAt    DateTime     @default(now())

  teamMembers TeamMember[]
}

model TeamMember {
  id           String     @id @default(cuid())
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         String? // e.g. "Lead"
}

// ============ PROJECTS & TASKS ============

model Project {
  id                  String       @id @default(cuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name                String
  code                String? // e.g. MER-014
  description         String?
  clientId            String?
  client              Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  managerMembershipId String?
  status              String       @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED | ARCHIVED
  priority            String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  budget              Float?
  startDate           DateTime     @default(now())
  endDate             DateTime?
  progress            Int          @default(0) // 0..100
  color               String?
  createdAt           DateTime     @default(now())

  milestones     Milestone[]
  tasks          Task[]
  projectMembers ProjectMember[]
  documents      Document[]
  meetings       Meeting[]
}

model ProjectMember {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         String? // e.g. "Developer", "Designer"
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | DELAYED
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  tasks Task[]
}

model Task {
  id                   String       @id @default(cuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId          String?
  milestone            Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title                String
  description          String?
  assigneeMembershipId String?
  creatorMembershipId  String?
  priority             String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status               String       @default("TODO") // BACKLOG | TODO | IN_PROGRESS | REVIEW | DONE
  startDate            DateTime?
  dueDate              DateTime?
  estimatedHours       Float?
  actualHours          Float?
  tags                 String? // CSV
  order                Int          @default(0)
  checklist            String? // JSON [{text, done}]
  parentTaskId         String?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())

  subtasks     Task[]           @relation("TaskSubtasks")
  parent       Task?            @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  dependencies TaskDependency[] @relation("TaskDepFrom")
  dependents   TaskDependency[] @relation("TaskDepTo")
  comments     Comment[]
  timeEntries  TimeEntry[]
  sessionEntries SessionTaskEntry[] // T3
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  task            Task   @relation("TaskDepFrom", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOnTask   Task   @relation("TaskDepTo", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  type            String @default("FS") // FS | SS | FF | SF
}

model TimeEntry {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membershipId String
  minutes      Int
  note         String?
  billable     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Comment {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entityType         String // TASK | PROJECT | LEAD | DEAL | ...
  entityId           String
  authorMembershipId String?
  author             Membership?  @relation(fields: [authorMembershipId], references: [id], onDelete: SetNull)
  body               String
  createdAt          DateTime     @default(now())
  task               Task?        @relation(fields: [taskId], references: [id])
  taskId             String?
}

model Meeting {
  id                    String       @id @default(cuid())
  orgId                 String
  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId             String?
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                 String
  startsAt              DateTime
  durationMins          Int          @default(30)
  agenda                String?
  notes                 String?
  createdByMembershipId String?
  createdBy             Membership?  @relation(fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  participants          String? // CSV of membership ids
  createdAt             DateTime     @default(now())
}

// ============ CRM ============

model Company {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  industry  String?
  website   String?
  address   String?
  notes     String?
  createdAt DateTime     @default(now())

  contacts Contact[]
  deals    Deal[]
  clients  Client[]
}

model Contact {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name      String
  position  String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime     @default(now())
  deals     Deal[]
}

model Client {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name         String
  contactEmail String?
  phone        String?
  status       String       @default("ACTIVE") // PROSPECT | ACTIVE | INACTIVE | CHURNED
  healthNote   String?
  since        DateTime     @default(now())

  projects Project[]
  invoices Invoice[]
}

model Lead {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name               String
  company            String?
  email              String?
  phone              String?
  source             String       @default("MANUAL") // WEBSITE | REFERRAL | SOCIAL | AD | OUTREACH | EVENT | IMPORT | MANUAL
  status             String       @default("NEW") // NEW | CONTACTED | QUALIFIED | UNQUALIFIED | CONVERTED
  value              Float?
  industry           String?
  notes              String?
  ownerMembershipId  String?
  convertedCompanyId String?
  createdAt          DateTime     @default(now())
}

model PipelineStage {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  order          Int          @default(0)
  isTerminalWon  Boolean      @default(false)
  isTerminalLost Boolean      @default(false)
  deals          Deal[]
}

model Deal {
  id                String        @id @default(cuid())
  orgId             String
  org               Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name              String
  value             Float         @default(0)
  companyId         String?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stageId           String
  stage             PipelineStage @relation(fields: [stageId], references: [id])
  probability       Int           @default(20) // 0..100
  expectedCloseDate DateTime?
  status            String        @default("OPEN") // OPEN | WON | LOST
  ownerMembershipId String?
  clientId          String? // set when won → client created
  projectId         String? // optional linked project after won
  notes             String?
  wonAt             DateTime?
  createdAt         DateTime      @default(now())
}

model CrmActivity {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entityType  String // LEAD | DEAL | CONTACT | CLIENT | COMPANY
  entityId    String
  type        String       @default("NOTE") // CALL | EMAIL | MEETING | NOTE | FOLLOWUP | TASK
  subject     String?
  notes       String?
  dueDate     DateTime?
  done        Boolean      @default(false)
  createdById String? // membership id
  createdBy   Membership?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
}

// ============ RECRUITMENT (ATS) ============

model Job {
  id                        String       @id @default(cuid())
  orgId                     String
  org                       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title                     String
  departmentId              String?
  department                Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description               String
  responsibilities          String?
  requirements              String?
  skills                    String? // CSV
  experienceLevel           String? // ENTRY | MID | SENIOR | LEAD
  employmentType            String       @default("FULL_TIME")
  location                  String?
  workMode                  String       @default("ONSITE") // REMOTE | HYBRID | ONSITE
  salaryMin                 Float?
  salaryMax                 Float?
  currency                  String       @default("BDT")
  deadline                  DateTime?
  openings                  Int          @default(1)
  visibility                String       @default("PUBLIC") // PUBLIC | PLATFORM | PRIVATE
  status                    String       @default("OPEN") // OPEN | PAUSED | CLOSED
  hiringManagerMembershipId String?
  createdAt                 DateTime     @default(now())

  applications Application[]
}

model Application {
  id                      String      @id @default(cuid())
  jobId                   String
  job                     Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId                  String? // platform user, if applied with account
  user                    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  candidateName           String
  email                   String
  phone                   String?
  resumeUrl               String?
  coverLetter             String?
  skills                  String? // CSV
  experienceYears         Float?
  stage                   String      @default("APPLIED") // APPLIED | SCREENING | SHORTLISTED | INTERVIEW | ASSESSMENT | OFFER | HIRED | REJECTED
  rating                  Int? // 1..5
  notes                   String?
  source                  String      @default("PLATFORM")
  processedByMembershipId String?
  processor               Membership? @relation("ApplicationProcessor", fields: [processedByMembershipId], references: [id], onDelete: SetNull)
  createdAt               DateTime    @default(now())
  decidedAt               DateTime?
}

// ============ HR ============

model Attendance {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membershipId  String
  membership    Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD (local org timezone)
  checkIn       DateTime?
  checkOut      DateTime?
  status        String       @default("PRESENT") // PRESENT | LATE | HALF_DAY | ABSENT | LEAVE | HOLIDAY
  workedMinutes Int?
  note          String?
  createdAt     DateTime     @default(now())

  sessions AttendanceSession[] // T3

  @@unique([membershipId, date])
}

model LeaveType {
  id            String         @id @default(cuid())
  orgId         String
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  daysPerYear   Int            @default(10)
  color         String?
  paid          Boolean        @default(true) // T3
  leaveRequests LeaveRequest[]
}

model LeaveRequest {
  id                   String       @id @default(cuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membershipId         String
  membership           Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  leaveTypeId          String
  leaveType            LeaveType    @relation(fields: [leaveTypeId], references: [id])
  startDate            DateTime
  endDate              DateTime
  days                 Int          @default(1)
  reason               String?
  status               String       @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  approverMembershipId String?
  decidedAt            DateTime?
  createdAt            DateTime     @default(now())
}

// ============ FINANCE ============

model Invoice {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number    String
  issueDate DateTime     @default(now())
  dueDate   DateTime
  status    String       @default("DRAFT") // DRAFT | SENT | VIEWED | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  items     String // JSON [{description, qty, rate}]
  subtotal  Float        @default(0)
  taxRate   Float        @default(0)
  taxAmount Float        @default(0)
  discount  Float        @default(0)
  total     Float        @default(0)
  notes     String?
  projectId String?
  paidAt    DateTime?
  createdAt DateTime     @default(now())
}

model Expense {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  projectId    String?
  title        String
  category     String       @default("GENERAL") // GENERAL | TRAVEL | MEALS | SOFTWARE | EQUIPMENT | MARKETING | OFFICE | TRAINING
  amount       Float
  date         DateTime     @default(now())
  status       String       @default("SUBMITTED") // SUBMITTED | MANAGER_APPROVED | FINANCE_APPROVED | PAID | REJECTED
  receiptUrl   String?
  notes        String?
  approvedById String?
  createdAt    DateTime     @default(now())
}

// ============ RBAC / POLICY (T3) ============

model ModuleAccess {
  id     String       @id @default(cuid())
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  module String // module id, e.g. 'tasks'
  role   String // OWNER | ADMIN | MANAGER | HR | FINANCE | EMPLOYEE | CONTRACTOR | INTERN
  level  String // FULL | VIEW | HIDDEN

  @@unique([orgId, module, role])
}

model OrgPolicy {
  id              String       @id @default(cuid())
  orgId           String       @unique
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  checkInTime     String       @default("09:00") // HH:MM — office start
  checkOutTime    String       @default("17:30") // HH:MM — office end
  lateGraceMins   Int          @default(15)
  halfDayMins     Int          @default(240)
  fullDayMins     Int          @default(480)
  workDays        String       @default("1,2,3,4,5") // CSV Mon=1..Sun=7 — weekly holidays = the rest
  overtimeEnabled Boolean      @default(false)
  payrollDay      Int          @default(28) // 1..28

  // T5: late-arrival penalties (applied in payroll)
  latePenaltyEnabled  Boolean  @default(false)
  latePenaltyThreshold Int     @default(3) // lates per month per full penalty occurrence
  latePenaltyMode     String   @default("HALF_DAY") // HALF_DAY | AMOUNT
  latePenaltyAmount   Float    @default(500) // per-occurrence deduction when mode=AMOUNT (org currency)
}

// ============ HOLIDAYS (T5) ============
// Org-scoped holiday calendar: government/public holidays + company closures.
// Weekly holidays come from OrgPolicy.workDays (the off days). Holidays do NOT
// consume leave days, are skipped by leave→attendance sync and are shaded in the Gantt.

model Holiday {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  type        String       @default("CUSTOM") // GOVT | COMPANY | CUSTOM
  startDate   DateTime // inclusive
  endDate     DateTime // inclusive (single-day = same as startDate)
  description String?
  createdAt   DateTime     @default(now())

  @@index([orgId, startDate])
}

// ============ ATTENDANCE SESSIONS (T3) ============

model AttendanceSession {
  id           String             @id @default(cuid())
  orgId        String
  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  attendanceId String
  attendance   Attendance         @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  checkIn      DateTime
  checkOut     DateTime?
  minutes      Int?
  note         String?
  entries      SessionTaskEntry[]
  createdAt    DateTime           @default(now())
  // NO unique — multiple sessions per day are allowed
}

model SessionTaskEntry {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  minutes   Int
  note      String?
}

// ============ KANBAN COLUMNS (T3) ============

model BoardColumn {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  surface    String       @default("TASK") // TASK | HIRING
  key        String // slug, unique per org+surface
  label      String
  order      Int          @default(0)
  isDone     Boolean      @default(false)
  isRejected Boolean      @default(false)
  color      String?
  createdAt  DateTime     @default(now())

  @@unique([orgId, surface, key])
}

// ============ PAYROLL (T3) ============

model PayrollRun {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period       String // "YYYY-MM"
  status       String       @default("DRAFT") // DRAFT | APPROVED | PAID
  note         String?
  createdById  String?
  createdBy    Membership?  @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy   Membership?  @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
  payslips     Payslip[]

  @@unique([orgId, period])
}

model Payslip {
  id                String       @id @default(cuid())
  runId             String
  run               PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  membershipId      String
  membership        Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  baseSalary        Float        @default(0)
  allowances        Float        @default(0)
  deductions        Float        @default(0)
  unpaidLeaveDays   Int          @default(0)
  unpaidLeaveAmount Float        @default(0)
  gross             Float        @default(0)
  net               Float        @default(0)
  presentDays       Int?
  absentDays        Int?
  lateDays          Int?
  breakdown         String // JSON [{label, kind: BASE|ALLOWANCE|DEDUCTION, amount}]
  createdAt         DateTime     @default(now())

  @@unique([runId, membershipId])
}

model SalaryComponent {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  label        String
  kind         String       @default("ALLOWANCE") // ALLOWANCE | DEDUCTION
  amount       Float        @default(0)
  createdAt    DateTime     @default(now())
}

// ============ COLLABORATION / PLATFORM ============

model Announcement {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authorMembershipId String?
  author             Membership?  @relation(fields: [authorMembershipId], references: [id], onDelete: SetNull)
  title              String
  body               String
  pinned             Boolean      @default(false)
  createdAt          DateTime     @default(now())
}

model Notification {
  id        String        @id @default(cuid())
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String        @default("SYSTEM") // TASK | PROJECT | LEAVE | FINANCE | CRM | HR | SYSTEM
  title     String
  body      String?
  module    String? // frontend module id to navigate to
  readAt    DateTime?
  createdAt DateTime      @default(now())
}

model Document {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder       String       @default("General") // Contracts | Policies | Finance | Projects | HR | General
  name         String
  mimeType     String?
  size         Int?
  storageKey   String? // R2 object key (production) — metadata only in sandbox
  version      Int          @default(1)
  uploadedById String?
  uploadedBy   Membership?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
}

model ActivityLog {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorMembershipId String?
  actor             Membership?  @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)
  action            String // e.g. "task.created"
  entityType        String
  entityId          String?
  message           String
  createdAt         DateTime     @default(now())
}

model AuditLog {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorMembershipId String?
  actor             Membership?  @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)
  action            String
  entity            String
  entityId          String?
  oldValues         String? // JSON
  newValues         String? // JSON
  createdAt         DateTime     @default(now())
}
