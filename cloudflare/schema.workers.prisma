// OrgOS — Enterprise SaaS schema
// D1-compatible: string IDs (cuid), no list fields, JSON payloads stored as String.
// Deploying to Cloudflare D1: generate SQL via
//   bunx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script
// (see cloudflare/migrations in this repo)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ IDENTITY ============

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  name                 String
  avatarUrl            String?
  headline             String?
  bio                  String?
  location             String?
  phone                String?
  skills               String? // CSV
  emailVerified        DateTime?
  emailVerifyToken     String? // uuid — email verification (no SMTP yet: surfaced in Settings → Security)
  passwordResetToken   String? // uuid — one-shot password reset (no SMTP yet: surfaced in response)
  passwordResetExpires DateTime? // expiry for password reset token (1 hour)
  mfaSecret            String? // base32 TOTP secret
  mfaEnabled           Boolean   @default(false)
  platformAdmin        Boolean   @default(false) // SaaS platform administrator (org-less console)
  status               String    @default("ACTIVE") // ACTIVE | SUSPENDED (platform moderation)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  sessions             Session[]
  memberships          Membership[]
  notifications        Notification[]
  applications         Application[]
  ownedOrgs            Organization[] @relation("OrgOwner")
  impersonatedSessions Session[]      @relation("SessionImpersonator")
}

model Session {
  id             String   @id // uuid token
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  impersonatedBy String? // platform admin userId when this is a support (impersonation) session
  // C9 fix: FK relation for impersonatedBy → User (was a plain String with no referential integrity)
  impersonator   User?    @relation("SessionImpersonator", fields: [impersonatedBy], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
}

// ============ ORGANIZATION (tenant) ============

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  industry    String?
  orgType     String? // Company | Startup | Agency | Team | Consultancy | Nonprofit | Community | Other
  website     String?
  country     String?
  timezone    String   @default("Asia/Dhaka")
  currency    String   @default("BDT")
  // H13-db fix: store Plan.code (UPPERCASE) instead of Plan.name (Title Case) for consistency.
  // Default is "GROWTH" (matches Plan.code). Previously stored "Growth" (Plan.name).
  plan        String   @default("GROWTH") // FREE | STARTER | GROWTH | BUSINESS | ENTERPRISE (matches Plan.code)
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED (platform moderation)
  foundedYear Int?
  ownerId     String
  // C9 fix: FK relation for ownerId → User (was a plain String with no referential integrity)
  owner       User     @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships    Membership[]
  departments    Department[]
  teams          Team[]
  projects       Project[]
  clients        Client[]
  companies      Company[]
  contacts       Contact[]
  leads          Lead[]
  deals          Deal[]
  pipelineStages PipelineStage[]
  jobs           Job[]
  invoices       Invoice[]
  expenses       Expense[]
  leaveTypes     LeaveType[]
  announcements  Announcement[]
  documents      Document[]
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  notifications  Notification[]
  activities     ActivityLog[]
  auditLogs      AuditLog[]
  crmActivities  CrmActivity[]
  comments       Comment[]
  meetings       Meeting[]
  tasks          Task[]
  holidays       Holiday[]

  // T3 additions
  moduleAccesses     ModuleAccess[]
  orgPolicy          OrgPolicy?
  attendanceSessions AttendanceSession[]
  boardColumns       BoardColumn[]
  payrollRuns        PayrollRun[]
  salaryComponents   SalaryComponent[]

  // SaaS platform billing (T6)
  subscriptions   Subscription[]
  billingRequests BillingRequest[]
}

// ============ SAAS PLATFORM BILLING (T6) ============

model Plan {
  id              String           @id @default(cuid())
  code            String           @unique // FREE | STARTER | GROWTH | BUSINESS | ENTERPRISE
  name            String
  description     String?
  priceMonthly    Int              @default(0) // org currency (BDT)
  priceYearly     Int              @default(0)
  currency        String           @default("BDT")
  seatLimit       Int              @default(5)
  projectLimit    Int              @default(3)
  storageGb       Int              @default(1)
  features        String? // JSON array of feature labels
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  subscriptions   Subscription[]
  billingRequests BillingRequest[]
  updatedAt       DateTime         @updatedAt

  // H13-db fix: ensure Plan.name is unique (prevents ambiguity when looking up by name)
  @@unique([name])
}

// Tenant-initiated upgrade/renewal request (manual payment confirmation flow —
// pluggable gateway point for Stripe/bKash/SSLCommerz later).
model BillingRequest {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingCycle  String       @default("MONTHLY") // MONTHLY | YEARLY
  seats         Int          @default(5)
  amount        Int          @default(0) // payment due for the period, in cents (org currency)
  note          String? // tenant note — e.g. transaction id / reference
  status        String       @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedById String?
  requestedBy   Membership?  @relation("BillingRequestBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([orgId, status])
}

model Subscription {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingCycle       String       @default("MONTHLY") // MONTHLY | YEARLY
  status             String       @default("ACTIVE") // TRIALING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  seats              Int          @default(5)
  amountMonthly      Int          @default(0) // normalized monthly amount, in cents (org currency)
  startedAt          DateTime     @default(now())
  currentPeriodStart DateTime     @default(now())
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([orgId])
}

model Membership {
  id               String       @id @default(cuid())
  userId           String
  orgId            String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role             String       @default("EMPLOYEE") // OWNER | ADMIN | MANAGER | HR | FINANCE | EMPLOYEE | CONTRACTOR | INTERN
  title            String? // position, e.g. "Senior Frontend Developer"
  departmentId     String?
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId        String? // manager Membership id
  // C10 fix: self-referential FK relation for managerId → Membership (was a plain String with no referential integrity)
  manager          Membership?  @relation("MemberManager", fields: [managerId], references: [id], onDelete: SetNull)
  employmentType   String       @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | FREELANCE | INTERN | TEMPORARY | VOLUNTEER
  status           String       @default("ACTIVE") // ACTIVE | ON_LEAVE | PROBATION | RESIGNED | TERMINATED | ALUMNI
  employeeCode     String?
  joinedAt         DateTime     @default(now())
  phone            String?
  emergencyContact String? // JSON {name, relation, phone}
  workSchedule     String? // JSON {days:[1..5], start:"09:30", end:"18:30"}
  baseSalary       Int? // monthly gross in cents, org currency (T3) (C7 fix: was Float)

  teamMembers     TeamMember[]
  projectMembers  ProjectMember[]
  attendances     Attendance[]
  leaveRequests   LeaveRequest[]
  activities      ActivityLog[]
  auditLogs       AuditLog[]
  crmActivities   CrmActivity[]
  comments        Comment[]
  documents       Document[]
  announcements   Announcement[]
  meetings        Meeting[]
  applications    Application[]    @relation("ApplicationProcessor")
  expenses        Expense[]
  billingRequests BillingRequest[] @relation("BillingRequestBy")

  // T3 additions
  attendanceSessions  AttendanceSession[]
  salaryComponents    SalaryComponent[]
  payslips            Payslip[]
  payrollRunsCreated  PayrollRun[]         @relation("PayrollRunCreatedBy")
  payrollRunsApproved PayrollRun[]         @relation("PayrollRunApprovedBy")
  // C10 fix: back-relation for the self-referential manager hierarchy
  directReports       Membership[]         @relation("MemberManager")
  // H12-db fix: back-relation for meeting participants join table
  meetingParticipants MeetingParticipant[]
  // M26-db back-relations for FK columns
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  ownedLeads          Lead[]               @relation("LeadOwner")
  ownedDeals          Deal[]               @relation("DealOwner")
  managedJobs         Job[]                @relation("JobHiringManager")
  managedProjects     Project[]            @relation("ProjectManager")
  approvedExpenses    Expense[]            @relation("ExpenseApprover")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime? // M25-db soft-delete

  @@unique([userId, orgId])
  // H8-db fix: index for org-scoped membership queries
  @@index([orgId, status])
}

model Department {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String? // hex accent for UI
  parentId    String? // self hierarchy
  // C10 fix: self-referential FK relation for parentId → Department (was a plain String with no referential integrity)
  parent      Department?  @relation("DeptParent", fields: [parentId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  memberships Membership[]
  teams       Team[]
  jobs        Job[]
  // C10 fix: back-relation for the self-referential department hierarchy
  children    Department[] @relation("DeptParent")
  updatedAt   DateTime     @updatedAt

  @@index([orgId])
}

model Team {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  name         String
  description  String?
  createdAt    DateTime     @default(now())

  teamMembers TeamMember[]
  updatedAt   DateTime     @updatedAt

  @@index([orgId])
}

model TeamMember {
  id           String     @id @default(cuid())
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         String? // e.g. "Lead"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // H7-db fix: prevent duplicate team-member rows from concurrent requests
  @@unique([teamId, membershipId])
  @@index([membershipId])
}

// ============ PROJECTS & TASKS ============

model Project {
  id                  String       @id @default(cuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name                String
  code                String? // e.g. MER-014
  description         String?
  clientId            String?
  client              Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  managerMembershipId String?
  manager             Membership?  @relation("ProjectManager", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  status              String       @default("PLANNING") // PLANNING | ACTIVE | ON_HOLD | COMPLETED | CANCELLED | ARCHIVED
  priority            String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  budget              Int? // in cents (C7 fix: was Float)
  startDate           DateTime     @default(now())
  endDate             DateTime?
  progress            Int          @default(0) // 0..100
  color               String?
  createdAt           DateTime     @default(now())

  milestones     Milestone[]
  tasks          Task[]
  wonDeals       Deal[]          @relation("DealProject")
  projectMembers ProjectMember[]
  documents      Document[]
  meetings       Meeting[]
  updatedAt      DateTime        @updatedAt

  @@index([orgId, status])
}

model ProjectMember {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         String? // e.g. "Developer", "Designer"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // H7-db fix: prevent duplicate project-member rows from concurrent requests
  @@unique([projectId, membershipId])
  @@index([membershipId])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | DELAYED
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  tasks     Task[]
  updatedAt DateTime @updatedAt

  // H9-db fix: index for project detail page milestone queries
  @@index([projectId])
}

model Task {
  id                   String       @id @default(cuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId          String?
  milestone            Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title                String
  description          String?
  assigneeMembershipId String?
  assignee             Membership?  @relation("TaskAssignee", fields: [assigneeMembershipId], references: [id], onDelete: SetNull)
  creatorMembershipId  String?
  creator              Membership?  @relation("TaskCreator", fields: [creatorMembershipId], references: [id], onDelete: SetNull)
  priority             String       @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status               String       @default("TODO") // BACKLOG | TODO | IN_PROGRESS | REVIEW | DONE
  startDate            DateTime?
  dueDate              DateTime?
  estimatedHours       Float?
  actualHours          Float?
  tags                 String? // CSV
  order                Int          @default(0)
  checklist            String? // JSON [{text, done}]
  parentTaskId         String?
  completedAt          DateTime?
  createdAt            DateTime     @default(now())

  subtasks       Task[]             @relation("TaskSubtasks")
  parent         Task?              @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  dependencies   TaskDependency[]   @relation("TaskDepFrom")
  dependents     TaskDependency[]   @relation("TaskDepTo")
  comments       Comment[]
  timeEntries    TimeEntry[]
  sessionEntries SessionTaskEntry[] // T3
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime? // M25-db soft-delete

  @@index([orgId, projectId])
  @@index([orgId, assigneeMembershipId])
  @@index([orgId, status])
}

model TaskDependency {
  id              String   @id @default(cuid())
  taskId          String
  task            Task     @relation("TaskDepFrom", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOnTask   Task     @relation("TaskDepTo", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  type            String   @default("FS") // FS | SS | FF | SF
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([taskId, dependsOnTaskId])
  // H9-db fix: index for reverse dependency lookups
  @@index([dependsOnTaskId])
}

model TimeEntry {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membershipId String
  minutes      Int
  note         String?
  billable     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // H9-db fix: indexes for time-entry queries (was zero indexes)
  @@index([taskId])
  @@index([membershipId])
}

model Comment {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entityType         String // TASK | PROJECT | LEAD | DEAL | ...
  entityId           String
  authorMembershipId String?
  author             Membership?  @relation(fields: [authorMembershipId], references: [id], onDelete: SetNull)
  body               String
  createdAt          DateTime     @default(now())
  task               Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId             String?
  updatedAt          DateTime     @updatedAt

  @@index([orgId, entityType, entityId])
  @@index([taskId])
}

model Meeting {
  id                    String       @id @default(cuid())
  orgId                 String
  org                   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId             String?
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                 String
  startsAt              DateTime
  durationMins          Int          @default(30)
  agenda                String?
  notes                 String?
  createdByMembershipId String?
  createdBy             Membership?  @relation(fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  // H12-db fix: participants moved from CSV String to a proper join table (MeetingParticipant).
  // The old `participants String?` column is kept for backward compat during migration but is no longer used.
  participants          String? // DEPRECATED — use MeetingParticipant join table
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  meetingParticipants MeetingParticipant[]

  @@index([orgId, startsAt])
}

// H12-db fix: proper join table for meeting participants (was CSV string, no FK enforcement)
model MeetingParticipant {
  id           String     @id @default(cuid())
  meetingId    String
  meeting      Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([meetingId, membershipId])
  @@index([membershipId])
}

// ============ CRM ============

model Company {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  industry  String?
  website   String?
  address   String?
  notes     String?
  createdAt DateTime     @default(now())

  contacts       Contact[]
  deals          Deal[]
  clients        Client[]
  convertedLeads Lead[]    @relation("LeadConvertedCompany") // M26-db back-relation
  updatedAt      DateTime  @updatedAt

  @@index([orgId])
}

model Contact {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name      String
  position  String?
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime     @default(now())
  deals     Deal[]
  updatedAt DateTime     @updatedAt

  @@index([orgId])
}

model Client {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name         String
  contactEmail String?
  phone        String?
  status       String       @default("ACTIVE") // PROSPECT | ACTIVE | INACTIVE | CHURNED
  healthNote   String?
  since        DateTime     @default(now())

  projects  Project[]
  invoices  Invoice[]
  wonDeals  Deal[]    @relation("DealWonClient") // M26-db back-relation
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([orgId])
}

model Lead {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name               String
  company            String?
  email              String?
  phone              String?
  source             String       @default("MANUAL") // WEBSITE | REFERRAL | SOCIAL | AD | OUTREACH | EVENT | IMPORT | MANUAL
  status             String       @default("NEW") // NEW | CONTACTED | QUALIFIED | UNQUALIFIED | CONVERTED
  value              Int? // in cents (C7 fix: was Float)
  industry           String?
  notes              String?
  ownerMembershipId  String?
  owner              Membership?  @relation("LeadOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  convertedCompanyId String?
  convertedCompany   Company?     @relation("LeadConvertedCompany", fields: [convertedCompanyId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([orgId])
  @@index([orgId, status])
}

model PipelineStage {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  order          Int          @default(0)
  isTerminalWon  Boolean      @default(false)
  isTerminalLost Boolean      @default(false)
  deals          Deal[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // M23-db fix: prevent duplicate order values within an org (non-deterministic UI sort)
  @@unique([orgId, order])
  @@index([orgId])
}

model Deal {
  id                String        @id @default(cuid())
  orgId             String
  org               Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name              String
  value             Int           @default(0) // in cents (C7 fix: was Float)
  companyId         String?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stageId           String
  stage             PipelineStage @relation(fields: [stageId], references: [id])
  probability       Int           @default(20) // 0..100
  expectedCloseDate DateTime?
  status            String        @default("OPEN") // OPEN | WON | LOST
  ownerMembershipId String?
  owner             Membership?   @relation("DealOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  clientId          String? // set when won → client created
  wonClient         Client?       @relation("DealWonClient", fields: [clientId], references: [id], onDelete: SetNull)
  projectId         String? // optional linked project after won
  linkedProject     Project?      @relation("DealProject", fields: [projectId], references: [id], onDelete: SetNull)
  notes             String?
  wonAt             DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orgId])
}

model CrmActivity {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entityType  String // LEAD | DEAL | CONTACT | CLIENT | COMPANY
  entityId    String
  type        String       @default("NOTE") // CALL | EMAIL | MEETING | NOTE | FOLLOWUP | TASK
  subject     String?
  notes       String?
  dueDate     DateTime?
  done        Boolean      @default(false)
  createdById String? // membership id
  createdBy   Membership?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId, entityId])
}

// ============ RECRUITMENT (ATS) ============

model Job {
  id                        String       @id @default(cuid())
  orgId                     String
  org                       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title                     String
  departmentId              String?
  department                Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description               String
  responsibilities          String?
  requirements              String?
  skills                    String? // CSV
  experienceLevel           String? // ENTRY | MID | SENIOR | LEAD
  employmentType            String       @default("FULL_TIME")
  location                  String?
  workMode                  String       @default("ONSITE") // REMOTE | HYBRID | ONSITE
  salaryMin                 Int? // in cents (C7 fix: was Float)
  salaryMax                 Int? // in cents (C7 fix: was Float)
  currency                  String       @default("BDT")
  deadline                  DateTime?
  openings                  Int          @default(1)
  visibility                String       @default("PUBLIC") // PUBLIC | PLATFORM | PRIVATE
  status                    String       @default("OPEN") // OPEN | PAUSED | CLOSED
  hiringManagerMembershipId String?
  hiringManager             Membership?  @relation("JobHiringManager", fields: [hiringManagerMembershipId], references: [id], onDelete: SetNull)
  createdAt                 DateTime     @default(now())

  applications Application[]
  updatedAt    DateTime      @updatedAt

  @@index([orgId, status])
}

model Application {
  id                      String      @id @default(cuid())
  jobId                   String
  job                     Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId                  String? // platform user, if applied with account
  user                    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  candidateName           String
  email                   String
  phone                   String?
  resumeUrl               String?
  coverLetter             String?
  skills                  String? // CSV
  experienceYears         Float?
  stage                   String      @default("APPLIED") // APPLIED | SCREENING | SHORTLISTED | INTERVIEW | ASSESSMENT | OFFER | HIRED | REJECTED
  rating                  Int? // 1..5
  notes                   String?
  source                  String      @default("PLATFORM")
  processedByMembershipId String?
  processor               Membership? @relation("ApplicationProcessor", fields: [processedByMembershipId], references: [id], onDelete: SetNull)
  createdAt               DateTime    @default(now())
  decidedAt               DateTime?
  updatedAt               DateTime    @updatedAt

  @@index([jobId])
  @@index([stage])
}

// ============ HR ============

model Attendance {
  id            String       @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membershipId  String
  membership    Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD (local org timezone)
  checkIn       DateTime?
  checkOut      DateTime?
  status        String       @default("PRESENT") // PRESENT | LATE | HALF_DAY | ABSENT | LEAVE | HOLIDAY
  workedMinutes Int?
  note          String?
  createdAt     DateTime     @default(now())

  sessions  AttendanceSession[] // T3
  updatedAt DateTime            @updatedAt

  @@unique([membershipId, date])
  @@index([orgId, date])
}

model LeaveType {
  id            String         @id @default(cuid())
  orgId         String
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name          String
  daysPerYear   Int            @default(10)
  color         String?
  paid          Boolean        @default(true) // T3
  leaveRequests LeaveRequest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orgId])
}

model LeaveRequest {
  id                   String       @id @default(cuid())
  orgId                String
  org                  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membershipId         String
  membership           Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  leaveTypeId          String
  leaveType            LeaveType    @relation(fields: [leaveTypeId], references: [id])
  startDate            DateTime
  endDate              DateTime
  days                 Int          @default(1)
  reason               String?
  status               String       @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  approverMembershipId String?
  decidedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([orgId, membershipId])
}

// ============ FINANCE ============

model Invoice {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  number    String
  issueDate DateTime     @default(now())
  dueDate   DateTime
  status    String       @default("DRAFT") // DRAFT | SENT | VIEWED | PARTIALLY_PAID | PAID | OVERDUE | CANCELLED
  items     String // JSON [{description, qty, rate}]
  subtotal  Int          @default(0) // in cents (C7 fix: was Float)
  taxRate   Float        @default(0)
  taxAmount Int          @default(0) // in cents (C7 fix: was Float)
  discount  Int          @default(0) // in cents (C7 fix: was Float)
  total     Int          @default(0) // in cents (C7 fix: was Float)
  notes     String?
  projectId String?
  paidAt    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime? // M25-db soft-delete

  @@index([orgId, clientId])
  @@index([orgId, status])
}

model Expense {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  projectId    String?
  title        String
  category     String       @default("GENERAL") // GENERAL | TRAVEL | MEALS | SOFTWARE | EQUIPMENT | MARKETING | OFFICE | TRAINING
  amount       Int // in cents (C7 fix: was Float)
  date         DateTime     @default(now())
  status       String       @default("SUBMITTED") // SUBMITTED | MANAGER_APPROVED | FINANCE_APPROVED | PAID | REJECTED
  receiptUrl   String?
  notes        String?
  approvedById String?
  approvedBy   Membership?  @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime? // M25-db soft-delete — null means active, non-null means deleted (for undo/restore)

  @@index([orgId, membershipId])
  @@index([orgId, status])
}

// ============ RBAC / POLICY (T3) ============

model ModuleAccess {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  module    String // module id, e.g. 'tasks'
  role      String // OWNER | ADMIN | MANAGER | HR | FINANCE | EMPLOYEE | CONTRACTOR | INTERN
  level     String // FULL | VIEW | HIDDEN
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orgId, module, role])
  // M35-db fix: index for the access-matrix lookup (orgId + role)
  @@index([orgId, role])
}

model OrgPolicy {
  id              String       @id @default(cuid())
  orgId           String       @unique
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  checkInTime     String       @default("09:00") // HH:MM — office start
  checkOutTime    String       @default("17:30") // HH:MM — office end
  lateGraceMins   Int          @default(15)
  halfDayMins     Int          @default(240)
  fullDayMins     Int          @default(480)
  workDays        String       @default("1,2,3,4,5") // CSV Mon=1..Sun=7 — weekly holidays = the rest
  overtimeEnabled Boolean      @default(false)
  payrollDay      Int          @default(28) // 1..28

  // T5: late-arrival penalties (applied in payroll)
  latePenaltyEnabled   Boolean  @default(false)
  latePenaltyThreshold Int      @default(3) // lates per month per full penalty occurrence
  latePenaltyMode      String   @default("HALF_DAY") // HALF_DAY | AMOUNT
  latePenaltyAmount    Int      @default(50000) // in cents, default 500 (C7 fix: was Float) // per-occurrence deduction when mode=AMOUNT (org currency)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ============ HOLIDAYS (T5) ============
// Org-scoped holiday calendar: government/public holidays + company closures.
// Weekly holidays come from OrgPolicy.workDays (the off days). Holidays do NOT
// consume leave days, are skipped by leave→attendance sync and are shaded in the Gantt.

model Holiday {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  type        String       @default("CUSTOM") // GOVT | COMPANY | CUSTOM
  startDate   DateTime // inclusive
  endDate     DateTime // inclusive (single-day = same as startDate)
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId, startDate])
}

// ============ ATTENDANCE SESSIONS (T3) ============

model AttendanceSession {
  id           String             @id @default(cuid())
  orgId        String
  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  attendanceId String
  attendance   Attendance         @relation(fields: [attendanceId], references: [id], onDelete: Restrict) // M24-db fix: protect time-tracking history
  checkIn      DateTime
  checkOut     DateTime?
  minutes      Int?
  note         String?
  entries      SessionTaskEntry[]
  createdAt    DateTime           @default(now())
  // NO unique — multiple sessions per day are allowed
  updatedAt    DateTime           @updatedAt

  @@index([orgId, membershipId])
  @@index([attendanceId])
}

model SessionTaskEntry {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  minutes   Int
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // H9-db fix: indexes for session-task-entry queries (was zero indexes)
  @@index([sessionId])
  @@index([taskId])
}

// ============ KANBAN COLUMNS (T3) ============

model BoardColumn {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  surface    String       @default("TASK") // TASK | HIRING
  key        String // slug, unique per org+surface
  label      String
  order      Int          @default(0)
  isDone     Boolean      @default(false)
  isRejected Boolean      @default(false)
  color      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([orgId, surface, key])
  // M23-db fix: prevent duplicate order values within an org+surface
  @@unique([orgId, surface, order])
}

// ============ PAYROLL (T3) ============

model PayrollRun {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  period       String // "YYYY-MM"
  status       String       @default("DRAFT") // DRAFT | APPROVED | PAID
  note         String?
  createdById  String?
  createdBy    Membership?  @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy   Membership?  @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
  payslips     Payslip[]
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime? // M25-db soft-delete — null means active, non-null means deleted (for undo/restore)

  @@unique([orgId, period])
  // M32-db fix: index for "list DRAFT runs in org" query
  @@index([orgId, status])
}

model Payslip {
  id                String     @id @default(cuid())
  runId             String
  run               PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  membershipId      String
  membership        Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  baseSalary        Int        @default(0) // in cents (C7 fix: was Float)
  allowances        Int        @default(0) // in cents (C7 fix: was Float)
  deductions        Int        @default(0) // in cents (C7 fix: was Float)
  unpaidLeaveDays   Int        @default(0)
  unpaidLeaveAmount Int        @default(0) // in cents (C7 fix: was Float)
  gross             Int        @default(0) // in cents (C7 fix: was Float)
  net               Int        @default(0) // in cents (C7 fix: was Float)
  presentDays       Int?
  absentDays        Int?
  lateDays          Int?
  breakdown         String // JSON [{label, kind: BASE|ALLOWANCE|DEDUCTION, amount}]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime? // M25-db soft-delete

  @@unique([runId, membershipId])
  @@index([membershipId])
}

model SalaryComponent {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  label        String
  kind         String       @default("ALLOWANCE") // ALLOWANCE | DEDUCTION
  amount       Int          @default(0) // in cents (C7 fix: was Float)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orgId, membershipId])
}

// ============ COLLABORATION / PLATFORM ============

model Announcement {
  id                 String       @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authorMembershipId String?
  author             Membership?  @relation(fields: [authorMembershipId], references: [id], onDelete: SetNull)
  title              String
  body               String
  pinned             Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([orgId, createdAt])
}

model Notification {
  id        String        @id @default(cuid())
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String        @default("SYSTEM") // TASK | PROJECT | LEAVE | FINANCE | CRM | HR | SYSTEM
  title     String
  body      String?
  module    String? // frontend module id to navigate to
  readAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, readAt])
  @@index([orgId, userId, readAt])
}

model Document {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder       String       @default("General") // Contracts | Policies | Finance | Projects | HR | General
  name         String
  mimeType     String?
  size         Int?
  storageKey   String? // R2 object key (production) — metadata only in sandbox
  version      Int          @default(1)
  uploadedById String?
  uploadedBy   Membership?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime? // M25-db soft-delete — null means active, non-null means deleted (for undo/restore)

  @@index([orgId])
  // M31-db fix: compound indexes for folder + project filtering
  @@index([orgId, folder])
  @@index([orgId, projectId])
}

model ActivityLog {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorMembershipId String?
  actor             Membership?  @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)
  action            String // e.g. "task.created"
  entityType        String
  entityId          String?
  message           String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([orgId, entityType, entityId])
  @@index([orgId, createdAt])
}

model AuditLog {
  id                String        @id @default(cuid())
  orgId             String? // null = platform-level action
  org               Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorMembershipId String?
  actor             Membership?   @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)
  action            String
  entity            String
  entityId          String?
  oldValues         String? // JSON
  newValues         String? // JSON
  // H6-auth fix: record which platform admin was impersonating the actor (null for normal actions).
  impersonatedBy    String? // platform admin userId when this action was performed during a support session
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orgId, createdAt])
}

// Public marketing site submissions (contact form + newsletter) — T7
model ContactMessage {
  id        String   @id @default(cuid())
  type      String   @default("CONTACT") // CONTACT | NEWSLETTER
  name      String?
  email     String
  company   String?
  topic     String? // general | sales | support | feedback | partnership
  message   String?
  status    String   @default("NEW") // NEW | READ | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status, createdAt])
  @@index([email])
}
